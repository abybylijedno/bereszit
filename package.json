    "books": "node scripts/fetch-books.mjs",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@fontsource/noto-serif-hebrew": "^5.3.0",
    "@types/diff": "^7.0.2",
    "diff": "^8.0.2",
